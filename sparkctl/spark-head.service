[Unit]
# 头节点推理。主进程退出才算失败；引擎卡死但进程还在时，需要先 stop 再 start。
Description=DeepSeek-V4-Flash-0731 head (native vLLM, TP=2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=linhaixiang
WorkingDirectory=/home/linhaixiang/sparkctl
ExecStart=/home/linhaixiang/sparkctl/dspark-head.sh
Restart=on-failure
RestartSec=15
LimitMEMLOCK=infinity
LimitSTACK=67108864

[Install]
WantedBy=multi-user.target
